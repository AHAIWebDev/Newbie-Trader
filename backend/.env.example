# Server Configuration
PORT=3001
NODE_ENV=development

# Polygon.io API Key
# Get yours free at: https://polygon.io/dashboard/signup
POLYGON_API_KEY=your_polygon_api_key_here

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database (PostgreSQL)
# Railway: added automatically when you attach the Postgres plugin
# Local dev: use a free Neon database (neon.tech) or a local PostgreSQL instance
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Frontend URL — set this on Railway to your Vercel domain (CORS)
# Comma-separate multiple origins if needed
# e.g. FRONTEND_URL=https://newbie-trader.vercel.app
FRONTEND_URL=http://localhost:5173

# NewsAPI.org — optional fallback for stock news
# Free tier: https://newsapi.org/register
# Only used when Polygon returns fewer than 3 results for a symbol.
NEWSAPI_KEY=
