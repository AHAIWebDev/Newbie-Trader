# Server Configuration
PORT=3001
NODE_ENV=development

# Polygon.io API Key
# Get yours free at: https://polygon.io/dashboard/signup
POLYGON_API_KEY=your_polygon_api_key_here

# Alpaca Paper Trading (Phase 3 - leave blank for now)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Anthropic Claude API
ANTHROPIC_API_KEY=

# Database — Phase 4C
# Local dev: SQLite file (no setup required)
DATABASE_URL="file:./prisma/dev.db"
# Production (Railway): replace with your Postgres connection string
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public"

# NewsAPI.org — optional fallback for stock news (Phase 4B)
# Free tier: https://newsapi.org/register
# Polygon.io news is tried first. This key is only used when Polygon
# returns fewer than 3 results for a given symbol.
NEWSAPI_KEY=
